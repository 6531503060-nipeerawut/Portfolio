# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local (and .env.production if you deploy somewhere that is not
# Vercel), then fill in the values. Real env files are not in git.
#
# Every key here is NEXT_PUBLIC_* and therefore baked into the bundle a visitor
# can read. Nothing secret belongs in this file, in any of its copies, or in
# this project at all — there is no server-side secret to keep.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this build is. local | production
# Must match the file it is written in — `npm run check:env` enforces that.
NEXT_PUBLIC_APP_ENV=local

# Absolute origin used to resolve canonical and Open Graph URLs at build time.
# In .env.production this is the live domain; locally it is the dev server.
# Left unset entirely the site falls back to VERCEL_PROJECT_PRODUCTION_URL and
# then to localhost — but `npm run check:env` wants every key to carry a value,
# because a key present and empty is the one case Next will not fill in for you.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
