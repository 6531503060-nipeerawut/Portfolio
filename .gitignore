# ─────────────────────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────────────────────
# .env.example is the list of keys and is tracked; the files holding real
# values are not. `npm run check:env` compares the two.
.env
.env.local
.env.production
.env*.local

# ─────────────────────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ─────────────────────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────────────────────
# .next = next build / next start, .next-dev = next dev. They are kept apart in
# next.config.ts; see the comment there for why.
/.next/
/.next-dev/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────────────
# Tooling
# ─────────────────────────────────────────────────────────────────────────────
.vercel
.eslintcache

# The agent instructions `next dev` writes for itself. CLAUDE.md is this
# project's own handbook and is tracked — do not add it back here.
AGENTS.md
